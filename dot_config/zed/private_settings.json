  "languages": {
    "Markdown": {
      "show_edit_predictions": false,
      "soft_wrap": "bounded",
      "preferred_line_length": 120,
    },
    "Python": {
      "language_servers": ["ty"],
    },
  },
  "agent": {
    "dock": "right",
    "tool_permissions": {
      "default": "allow",
    },
    "profiles": {
      "code": {
        "default_model": {
          "provider": "zed.dev",
          "model": "claude-opus-4-1",
        },
        "name": "Code",
        "tools": {
          "search_web": true,
          "copy_path": true,
          "create_directory": true,
          "delete_path": true,
          "diagnostics": true,
          "edit_file": true,
          "fetch": true,
          "list_directory": true,
          "project_notifications": false,
          "move_path": true,
          "now": true,
          "find_path": true,
          "read_file": true,
          "restore_file_from_disk": true,
          "save_file": true,
          "open": true,
          "grep": true,
          "terminal": true,
          "thinking": true,
        },
        "enable_all_context_servers": true,
        "context_servers": {},
      },
    },
    "default_profile": "write",
    "inline_assistant_model": {
      "provider": "lmstudio",
      "model": "bonsai-8b",
    },
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "zed.dev",
      "model": "claude-opus-4-6-thinking",
    },
  },
  "show_edit_predictions": true,
  "edit_predictions": {
    "provider": "zed",
    "mode": "subtle",
  },
  "show_completions_on_input": true,
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "clippy",
        },
        "cargo": {
          "features": "all",
        },
        "rustfmt": { "extraArgs": ["+nightly"] },
        "inlayHints": {
          "maxLength": null,
          "lifetimeElisionHints": {
            "enable": "skip_trivial",
            "useParameterNames": true,
          },
          "closureReturnTypeHints": {
            "enable": "always",
          },
        },
      },
    },
    "ty": {
      "binary": {
        "path": "/Users/colinmarc/.local/bin/ty",
        "arguments": ["server"],
      },
    },
  },
  "ui_font_size": 15,
  "buffer_font_family": "Inconsolata Nerd Font Mono",
  "buffer_font_size": 15.0,
  "current_line_highlight": "gutter",
  "experimental.theme_overrides": {
    "editor.document_highlight.read_background": "#363646",
    "error.background": "#2A2A37",
    "error.border": "#363646",
    "warning.background": "#2A2A37",
    "warning.border": "#363646",
    "diagnostic.background": "#2A2A37",
    "diagnostic.border": "#363646",
    // "search.match_background": "#DCD7BA"
  },
  "theme": {
    "mode": "dark",
    "light": "Catppuccin Latte - No Italics",
    "dark": "Kanagawa Wave - No Italics",
  },
  "gutter": {
    "code_actions": false,
    "runnables": false,
    "folds": false,
  },
  "vim_mode": true,
  "helix_mode": true,
  "base_keymap": "VSCode",
  "file_types": {
    "diff": ["prr"],
  },
}
